# sophie shepherd config — Anthropic API access.
#
# To bootstrap sophie locally:
#   1. Copy this file to claude-api-key.toml (drop the .example suffix).
#   2. Paste your real Anthropic API key into api_key.
#   3. Run `dig api.anthropic.com +short` and paste one of the IPs into
#      endpoint_ip. sophie doesn't have a DNS resolver yet, so you must
#      supply a concrete IPv4. Refresh when builds start FAILing with
#      a connect error.
#
# The real claude-api-key.toml is .gitignore'd — this .example template
# is committed as the schema reference.

api_key = "sk-ant-PASTE-YOUR-KEY-HERE"

# Anthropic's api.anthropic.com is fronted by CloudFront; any one of
# its anycast IPs accepts SNI for the hostname. Refresh via:
#   dig api.anthropic.com +short
endpoint_ip = "1.2.3.4"

# Optional: override the default Claude model. Comment out to use the
# default pinned in sophie's source (currently claude-opus-4-5).
# model = "claude-opus-4-5"
