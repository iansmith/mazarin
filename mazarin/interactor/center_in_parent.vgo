func center_in_parent() Point2D {
	pulx := point2d_x(deref_point2d("_parentUL_"))
	puly := point2d_y(deref_point2d("_parentUL_"))
	pw := deref_i64("_parentWidth_")
	ph := deref_i64("_parentHeight_")
	mw := deref_i64("_myWidth_")
	mh := deref_i64("_myHeight_")
	x := pulx + (pw-mw)/2
	y := puly + (ph-mh)/2
	return point2d(x, y)
}
