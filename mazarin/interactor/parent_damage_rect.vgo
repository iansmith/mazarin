func parent_damage_rect() Rect {
	bounds := deref_rect("_bounds_")
	lpBounds := deref_rect("_lpBounds_")
	vis := deref_bool("_visible_")
	lpVis := deref_bool("_lpVisible_")
	bgc := deref_i64("_bgColor_")
	lpBgc := deref_i64("_lpBgColor_")
	tc := deref_i64("_textColor_")
	lpTc := deref_i64("_lpTextColor_")

	ownDamage := rect(0, 0, 0, 0)
	if vis != lpVis {
		ownDamage = rect_union(bounds, lpBounds)
	}
	if bgc != lpBgc {
		ownDamage = rect_union(bounds, lpBounds)
	}
	if tc != lpTc {
		ownDamage = rect_union(bounds, lpBounds)
	}

	childDmg := deref_rect("_childDamage_")
	if !rect_empty(childDmg) {
		if rect_empty(ownDamage) {
			return childDmg
		}
		return rect_union(ownDamage, childDmg)
	}
	return ownDamage
}
