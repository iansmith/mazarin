func column_width() int64 {
	children := find("_0_")
	maxw := int64(0)
	for _, uri := range children {
		pname := deref_str(uri)
		if pname == "_1_" {
			seg := uri_segment(uri, 3)
			wuri := str_concat(str_concat("_2_", seg), "_3_")
			w := deref_i64(wuri)
			if w > maxw {
				maxw = w
			}
		}
	}
	return maxw
}
