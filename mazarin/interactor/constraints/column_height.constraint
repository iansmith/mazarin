func column_height() int64 {
	children := find("_0_")
	spacing := deref_i64("_1_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		pname := deref_str(uri)
		if pname == "_2_" {
			seg := uri_segment(uri, 3)
			huri := str_concat(str_concat("_3_", seg), "_4_")
			total = total + deref_i64(huri)
			n = n + 1
		}
	}
	if n > 1 {
		total = total + (n - 1) * spacing
	}
	return total
}
