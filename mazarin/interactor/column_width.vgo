import "children"

func columnWidth() int64 {
	// No children: default empty width.
	if hasNoChildren("_0_", "_1_") {
		return int64(20)
	}

	// One child: decorator-like (child width + spacing as margin).
	oneChild := hasOneChild("_0_", "_1_")
	if oneChild != "" {
		seg := uri_segment(oneChild, 3)
		wuri := str_concat(str_concat("_2_", seg), "_3_")
		return deref_i64(wuri)
	}

	// Two+ children: max of children widths.
	children := find("_0_")
	maxw := int64(0)
	for _, uri := range children {
		pname := deref_str(uri)
		if pname == "_1_" {
			seg := uri_segment(uri, 3)
			wuri := str_concat(str_concat("_2_", seg), "_3_")
			w := deref_i64(wuri)
			if w > maxw {
				maxw = w
			}
		}
	}
	return maxw
}
