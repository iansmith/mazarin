import "children"

func simpleDecoratorInsideOut(myName string, margin int64, dimPrefix string, dimSuffix string, defaultSize int64, maxSize int64) int64 {
	childURI := hasOneChild(myName)
	size := defaultSize
	if childURI != "" {
		seg := uri_segment(childURI, 3)
		size = deref_i64(dimPrefix + seg + dimSuffix)
	}
	result := size + margin + margin
	if result > maxSize {
		return maxSize
	}
	return result
}
