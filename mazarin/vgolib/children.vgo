func hasNoChildren(findPattern string, myName string) bool {
	children := find(findPattern)
	for _, uri := range children {
		if deref_str(uri) == myName {
			return false
		}
	}
	return true
}

func hasOneChild(findPattern string, myName string) string {
	children := find(findPattern)
	result := ""
	n := int64(0)
	for _, uri := range children {
		if deref_str(uri) == myName {
			result = uri
			n = n + 1
		}
	}
	if n == 1 {
		return result
	}
	return ""
}

func numChildren(findPattern string, myName string) int64 {
	children := find(findPattern)
	n := int64(0)
	for _, uri := range children {
		if deref_str(uri) == myName {
			n = n + 1
		}
	}
	return n
}

func nthChild(findPattern string, myName string, index int64) string {
	children := find(findPattern)
	n := int64(0)
	result := ""
	for _, uri := range children {
		if deref_str(uri) == myName {
			if n == index {
				result = uri
			}
			n = n + 1
		}
	}
	return result
}
