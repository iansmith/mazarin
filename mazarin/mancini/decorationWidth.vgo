import "children"

func decorationWidth() int64 {
	padding := derefI64("_padding_")
	maxSize := derefI64("_maxSize_")
	childURI := hasOneChild("_myName_")
	size := int64(20)
	if childURI != "" {
		seg := uriSegment(childURI, 3)
		size = childWidth(seg)
	}
	result := size + padding + padding
	if maxSize > 0 && result > maxSize {
		return maxSize
	}
	return result
}
