import "children"

func decorationHeight() int64 {
	margin := derefI64("_margin_")
	maxSize := derefI64("_maxSize_")
	childURI := hasOneChild("_myName_")
	size := int64(30)
	if childURI != "" {
		seg := uriSegment(childURI, 3)
		size = childHeight(seg)
	}
	result := size + margin + margin
	if result > maxSize {
		return maxSize
	}
	return result
}
