import "children"

func minMaxColumnHeight() int64 {
	minH := deref_i64("_minH_")
	maxH := deref_i64("_maxH_")

	if hasNoChildren("_myName_") {
		return minH
	}

	children := findVisibleChildren("_myName_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		seg := uri_segment(uri, 3)
		h := childHeight(seg)
		total = total + h
		n = n + 1
	}
	if n > 1 {
		total = total + (n - 1)
	}
	return clamp(total, minH, maxH)
}
