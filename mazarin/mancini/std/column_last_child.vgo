import "children"

func columnLastChild() int64 {
	maxH := derefI64("_maxHeight_")
	spacing := derefI64("_spacing_")
	padding := derefI64("_vPadding_")

	if hasNoVisibleChildren("_myName_") {
		return int64(-1)
	}

	children := findVisibleChildren("_myName_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		seg := uriSegment(uri, 3)
		h := childHeight(seg)
		next := total + h
		if n > 0 {
			next = next + spacing
		}
		// no bottom margin when clipping
		if next + padding > maxH {
			return n
		}
		total = next
		n = n + 1
	}
	return n
}
