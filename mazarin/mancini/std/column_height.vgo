import "children"

func columnHeight() int64 {
	maxH := derefI64("_maxHeight_")
	spacing := derefI64("_spacing_")
	margin := derefI64("_vMargin_")

	if hasNoVisibleChildren("_myName_") {
		return int64(20)
	}

	children := findVisibleChildren("_myName_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		seg := uriSegment(uri, 3)
		h := childHeight(seg)
		next := total + h
		if n > 0 {
			next = next + spacing
		}
		if next + margin > maxH {
			return maxH
		}
		total = next
		n = n + 1
	}
	return total + 2*margin
}
