import "children"

func columnHeight() int64 {
	if hasNoChildren("_myName_") {
		return int64(30)
	}

	spacing := deref_i64("_spacing_")

	oneChild := hasOneChild("_myName_")
	if oneChild != "" {
		seg := uri_segment(oneChild, 3)
		return childHeight(seg) + spacing + spacing
	}

	children := findVisibleChildren("_myName_")
	total := int64(0)
	n := int64(0)
	firstH := int64(0)
	for _, uri := range children {
		seg := uri_segment(uri, 3)
		h := childHeight(seg)
		total = total + h
		if n == 0 {
			firstH = h
		}
		n = n + 1
	}
	if n > 1 {
		total = total + (n - 1) * spacing
	}
	minH := firstH + spacing + spacing
	return max(total, minH)
}
