import "children"

func rowHeight() int64 {
	if hasNoChildren("_myName_") {
		return int64(30)
	}

	oneChild := hasOneChild("_myName_")
	if oneChild != "" {
		seg := uriSegment(oneChild, 3)
		return childHeight(seg)
	}

	children := findVisibleChildren("_myName_")
	maxh := int64(0)
	for _, uri := range children {
		seg := uriSegment(uri, 3)
		h := childHeight(seg)
		if h > maxh {
			maxh = h
		}
	}
	return maxh
}
