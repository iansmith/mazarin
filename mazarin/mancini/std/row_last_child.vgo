import "children"

func rowLastChild() int64 {
	maxW := deref_i64("_maxWidth_")
	spacing := deref_i64("_spacing_")

	children := find("_findPattern_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		pname := deref_str(uri)
		if pname == "_myName_" {
			seg := uri_segment(uri, 3)
			if isChildVisible("_int64Prefix_", "_visSuffix_", seg) {
				wuri := str_concat(str_concat("_int64Prefix_", seg), "_widthSuffix_")
				w := deref_i64(wuri)

				next := total + w
				if n > 0 {
					next = next + spacing
				}
				if next > maxW {
					return n
				}
				total = next
				n = n + 1
			}
		}
	}
	return n
}
