import "children"

func rowWidth() int64 {
	maxW := deref_i64("_maxWidth_")
	spacing := deref_i64("_spacing_")
	margin := deref_i64("_hMargin_")

	if hasNoVisibleChildren("_myName_") {
		return int64(20)
	}

	children := findVisibleChildren("_myName_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		seg := uri_segment(uri, 3)
		w := childWidth(seg)
		next := total + w
		if n > 0 {
			next = next + spacing
		}
		if next + margin > maxW {
			return maxW
		}
		total = next
		n = n + 1
	}
	return total + 2*margin
}
