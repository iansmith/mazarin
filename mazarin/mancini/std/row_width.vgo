import "children"

func rowWidth() int64 {
	maxW := derefI64("_maxWidth_")
	spacing := derefI64("_spacing_")
	padding := derefI64("_hPadding_")

	if hasNoVisibleChildren("_myName_") {
		return int64(20)
	}

	children := findVisibleChildren("_myName_")
	total := int64(0)
	n := int64(0)
	for _, uri := range children {
		seg := uriSegment(uri, 3)
		w := childWidth(seg)
		next := total + w
		if n > 0 {
			next = next + spacing
		}
		if next + padding > maxW {
			return maxW
		}
		total = next
		n = n + 1
	}
	return total + 2*padding
}
