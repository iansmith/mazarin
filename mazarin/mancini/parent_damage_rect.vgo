func parentDamageRect() Rect {
	bounds := derefRect("_bounds_")
	lpBounds := derefRect("_lpBounds_")
	vis := derefBool("_visible_")
	lpVis := derefBool("_lpVisible_")
	bgc := derefI64("_bgColor_")
	lpBgc := derefI64("_lpBgColor_")
	fgc := derefI64("_fgColor_")
	lpFgc := derefI64("_lpFgColor_")
	boundsHash := derefI64("_boundsHash_")
	lpBoundsHash := derefI64("_lpBoundsHash_")

	ownDamage := rect(0, 0, 0, 0)
	if vis != lpVis {
		ownDamage = rectUnion(bounds, lpBounds)
	}
	if bgc != lpBgc {
		ownDamage = rectUnion(bounds, lpBounds)
	}
	if fgc != lpFgc {
		ownDamage = rectUnion(bounds, lpBounds)
	}
	if boundsHash != lpBoundsHash {
		ownDamage = rectUnion(bounds, lpBounds)
	}

	childDmg := derefRect("_childDamage_")
	if !rectEmpty(childDmg) {
		if rectEmpty(ownDamage) {
			return childDmg
		}
		return rectUnion(ownDamage, childDmg)
	}
	return ownDamage
}
