#!/bin/bash
# Stop any running QEMU instances
# Usage: scripts/stop

pkill -f qemu-system-aarch64 2>/dev/null
sleep 0.3

# Check if any are still running
if pgrep -f qemu-system-aarch64 >/dev/null 2>&1; then
    echo "Warning: QEMU still running, sending SIGKILL..."
    pkill -9 -f qemu-system-aarch64 2>/dev/null
    sleep 0.2
fi

echo "QEMU stopped"
