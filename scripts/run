#!/bin/bash
# Run QEMU with cardinal/kmazarin
# Usage: scripts/run [-t TIMEOUT] [-c] [-s] [wait_seconds]
#
# Options:
#   -t TIMEOUT  Kill QEMU after TIMEOUT seconds
#   -c          Count mode: count occurrences of 111222 and 222111 instead of showing output
#   -s          Squeeze mode: compress repeated 1's and 2's to single characters
#   wait_secs   Seconds to wait before showing output (default: 3)
#
# Environment:
#   QEMU        Path to qemu-system-aarch64 (default: PATH)
#
# Output is written to /tmp/cardinal-serial.log
# QEMU monitor available at tcp:127.0.0.1:4444
#
# Requires QEMU 10.2 or later.
# IMPORTANT: bochs-display is REQUIRED for serial output to work!
# Do NOT use pipes (tee, tail piping) - causes buffering issues.

# Determine script location and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAZZY_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Required QEMU version (minimum)
REQUIRED_QEMU_VERSION="10.2"

# Find QEMU: use QEMU env var, then PATH
if [ -n "$QEMU" ]; then
    # User specified QEMU path
    if [ ! -x "$QEMU" ]; then
        echo ""
        echo "ERROR: Specified QEMU not found or not executable: $QEMU"
        echo ""
        exit 1
    fi
elif command -v qemu-system-aarch64 &>/dev/null; then
    QEMU="qemu-system-aarch64"
else
    echo ""
    echo "ERROR: qemu-system-aarch64 not found"
    echo ""
    echo "Install QEMU $REQUIRED_QEMU_VERSION+ or set QEMU to point to it:"
    echo "  QEMU=/path/to/qemu-system-aarch64 scripts/run"
    echo ""
    exit 1
fi

# Version check - verify QEMU version is at least $REQUIRED_QEMU_VERSION
QEMU_VERSION=$("$QEMU" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
if [ -z "$QEMU_VERSION" ]; then
    echo ""
    echo "ERROR: Could not determine QEMU version"
    echo ""
    exit 1
fi

# Compare versions (major.minor)
QEMU_MAJOR=$(echo "$QEMU_VERSION" | cut -d. -f1)
QEMU_MINOR=$(echo "$QEMU_VERSION" | cut -d. -f2)
REQ_MAJOR=$(echo "$REQUIRED_QEMU_VERSION" | cut -d. -f1)
REQ_MINOR=$(echo "$REQUIRED_QEMU_VERSION" | cut -d. -f2)

if [ "$QEMU_MAJOR" -lt "$REQ_MAJOR" ] || \
   ([ "$QEMU_MAJOR" -eq "$REQ_MAJOR" ] && [ "$QEMU_MINOR" -lt "$REQ_MINOR" ]); then
    echo ""
    echo "ERROR: QEMU version mismatch."
    echo ""
    echo "  Required: $REQUIRED_QEMU_VERSION+"
    echo "  Found:    $QEMU_VERSION (from: $QEMU)"
    echo ""
    echo "Install QEMU $REQUIRED_QEMU_VERSION+ or set QEMU to point to it:"
    echo "  QEMU=/path/to/qemu-system-aarch64 scripts/run"
    echo ""
    exit 1
fi

# Parse options
TIMEOUT_SECS=""
COUNT_MODE=0
SQUEEZE_MODE=0

while getopts "t:cs" opt; do
    case $opt in
        t) TIMEOUT_SECS="$OPTARG" ;;
        c) COUNT_MODE=1 ;;
        s) SQUEEZE_MODE=1 ;;
        *) echo "Usage: $0 [-t TIMEOUT] [-c] [-s] [wait_seconds]" >&2; exit 1 ;;
    esac
done
shift $((OPTIND-1))

WAIT_SECS=${1:-3}
LOG_FILE=/tmp/cardinal-serial.log

cd "$MAZZY_ROOT"

# Stop any existing QEMU
pkill -f qemu-system-aarch64 2>/dev/null
sleep 0.3

# Clear old log
rm -f "$LOG_FILE"

echo "=== Starting QEMU (wait ${WAIT_SECS}s) ==="

# Run QEMU in background
# CRITICAL: bochs-display is required for serial output!
"$QEMU" \
    -M virt,virtualization=off \
    -cpu cortex-a72 \
    -m 8G \
    -kernel build/cardinal.elf \
    -nodefaults \
    -device bochs-display \
    -object rng-random,id=rng0,filename=/dev/urandom \
    -device virtio-rng-pci,rng=rng0,disable-legacy=on \
    -display none \
    -serial file:${LOG_FILE} \
    -monitor tcp:127.0.0.1:4444,server,nowait \
    -semihosting \
    -no-reboot &

QEMU_PID=$!
echo "QEMU PID: $QEMU_PID"
echo "Log file: $LOG_FILE"
echo "Monitor: tcp:127.0.0.1:4444"

# Setup timeout if requested
if [ -n "$TIMEOUT_SECS" ]; then
    echo "Timeout: ${TIMEOUT_SECS}s"
    (sleep "$TIMEOUT_SECS" && kill $QEMU_PID 2>/dev/null) &
    TIMEOUT_PID=$!
fi

# Wait for output
sleep "$WAIT_SECS"

# Show output or count patterns
if [ "$COUNT_MODE" -eq 1 ]; then
    # Count mode: analyze patterns in the log file
    echo ""
    echo "=== Pattern Analysis ==="

    # Use awk to count occurrences of both patterns
    # Read entire file as single record to handle patterns across line boundaries
    # and non-printable characters correctly
    awk 'BEGIN {RS="^$"} {
        count_111222 = gsub(/111222/, "&")
        count_222111 = gsub(/222111/, "&")
        printf "111222 occurrences: %d\n", count_111222
        printf "222111 occurrences: %d\n", count_222111
        printf "Total patterns: %d\n", count_111222 + count_222111
    }' "$LOG_FILE"

    echo "=== Log size: $(wc -c < "$LOG_FILE" 2>/dev/null || echo 0) bytes ==="
else
    # Normal mode: show output with SAFE filtering (removes terminal control sequences)
    # CRITICAL: Use tr -d to strip all control characters BEFORE they reach the terminal
    # This prevents terminal hangs from escape sequences in the serial output
    echo ""
    if [ "$SQUEEZE_MODE" -eq 1 ]; then
        echo "=== Serial Output (compressed, last 500 chars) ==="
        tail -c 500 "$LOG_FILE" 2>/dev/null | tr -d '\000-\010\013-\037\177-\377' | tr -s '12' || echo "(no output yet)"
    else
        echo "=== Serial Output (last 500 chars) ==="
        tail -c 500 "$LOG_FILE" 2>/dev/null | tr -d '\000-\010\013-\037\177-\377' || echo "(no output yet)"
    fi
    echo ""
    echo "=== Log size: $(wc -c < "$LOG_FILE" 2>/dev/null || echo 0) bytes ==="

    # Always show preemptive scheduling pattern counts
    echo ""
    echo "=== Preemptive Scheduling Indicators ==="
    awk 'BEGIN {RS="^$"} {
        count_111222 = gsub(/111222/, "&")
        count_222111 = gsub(/222111/, "&")
        total = count_111222 + count_222111
        printf "111222 occurrences: %d\n", count_111222
        printf "222111 occurrences: %d\n", count_222111
        printf "Total patterns: %d", total
        if (total <= 2) {
            printf " ⚠️  LOW - possible scheduling issue!\n"
        } else {
            printf " ✓\n"
        }
    }' "$LOG_FILE"
fi
